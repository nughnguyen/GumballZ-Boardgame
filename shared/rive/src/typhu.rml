<!-- LƯU Ý: RML này là bản đặc tả v1 (chỉ để tham khảo/kiểm tra bằng CLI). Nguồn build .riv CHÍNH THỨC là build.mjs (kiến trúc v2). -->
<!-- Cờ Tỷ Phú — xúc xắc đỏ nảy + xoay, đổi mặt chấm ở đỉnh nảy.
     Artboard 200×200, animation "loop" 120 frames @60fps = 2s, lặp vô hạn.
     Nguồn RML (bản đặc tả, biên dịch được bằng Rive CLI: rive . --verify).
     File .riv đi kèm được build bằng shared/rive/src/build.mjs (thư viện
     @stevysmith/rive-generator) vì CLI không xuất .riv khi chưa đăng nhập.
     Màu: đỏ #FF5A60, mực #241A38, kem #FFF8EE. -->
<Rive version="1" kind="fragment">
    <Artboard width="200" height="200" name="typhu" id="0:1">
        <!-- LƯU Ý thứ tự vẽ (Rive): con ĐẦU TIÊN trong danh sách vẽ Ở TRÊN cùng.
             Nên xếp từ trước ra sau: chi tiết mặt -> thân -> bóng đổ. -->
        <!-- Xúc xắc: node để nảy + xoay cả cụm -->
        <Node x="100" y="100" name="Die" id="0:3">
            <!-- Mặt 5 chấm (trên cùng) -->
            <Shape x="0" y="0" name="Face5" id="0:5">
                <Ellipse originX="0.5" originY="0.5" x="-19" y="-19" width="14" height="14" name="Pip"/>
                <Ellipse originX="0.5" originY="0.5" x="19" y="-19" width="14" height="14" name="Pip"/>
                <Ellipse originX="0.5" originY="0.5" x="0" y="0" width="14" height="14" name="Pip"/>
                <Ellipse originX="0.5" originY="0.5" x="-19" y="19" width="14" height="14" name="Pip"/>
                <Ellipse originX="0.5" originY="0.5" x="19" y="19" width="14" height="14" name="Pip"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFF8EE" name="Color"/>
                </Fill>
            </Shape>
            <!-- Mặt 2 chấm (hiện ở đỉnh nảy) -->
            <Shape x="0" y="0" name="Face2" id="0:6">
                <Ellipse originX="0.5" originY="0.5" x="-19" y="-19" width="14" height="14" name="Pip"/>
                <Ellipse originX="0.5" originY="0.5" x="19" y="19" width="14" height="14" name="Pip"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFF8EE" name="Color"/>
                </Fill>
            </Shape>
            <Shape x="0" y="0" name="Body" id="0:4">
                <Rectangle originX="0.5" originY="0.5" width="72" height="72" cornerRadiusTL="14" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFF5A60" name="Color"/>
                </Fill>
                <Stroke thickness="4" name="Stroke">
                    <SolidColor colorValue="FF241A38" name="Color"/>
                </Stroke>
            </Shape>
        </Node>
        <!-- Bóng đổ dưới xúc xắc (sau cùng = nằm dưới) -->
        <Shape x="100" y="150" name="Shadow" id="0:2">
            <Ellipse originX="0.5" originY="0.5" width="56" height="12" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="33241A38" name="Color"/>
            </Fill>
        </Shape>
        <LinearAnimation duration="120" fps="60" loopValue="loop" name="loop" id="0:7">
            <KeyedObject objectId="0:3">
                <KeyedProperty property="y">
                    <KeyFrameDouble frame="0" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="30" value="52" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="60" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="90" value="76" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="120" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble frame="0" value="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="30" value="0.6" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="60" value="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="90" value="0.3" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="120" value="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble frame="0" value="1" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="56" value="1" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="60" value="0.82" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="66" value="1" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="120" value="1" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:5">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble frame="0" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="28" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="30" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="88" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="90" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="120" value="1" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:6">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble frame="0" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="28" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="30" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="88" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="90" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="120" value="0" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:2">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble frame="0" value="1" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="30" value="0.6" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="60" value="1" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="90" value="0.8" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="120" value="1" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
