<!-- LƯU Ý: RML này là bản đặc tả v1 (chỉ để tham khảo/kiểm tra bằng CLI). Nguồn build .riv CHÍNH THỨC là build.mjs (kiến trúc v2). -->
<!-- Cờ Tướng — quân Tướng đỏ trượt qua lại trên bàn + nhún nhẹ.
     Artboard 200×200, animation "loop" 180 frames @60fps = 3s, lặp vô hạn.
     Nguồn RML (bản đặc tả, biên dịch được bằng Rive CLI: rive . --verify).
     File .riv đi kèm được build bằng shared/rive/src/build.mjs (thư viện
     @stevysmith/rive-generator) vì CLI không xuất .riv khi chưa đăng nhập.
     Màu: đỏ #FF5A60, mực #241A38, ngọc #2EC5B6, kem #FFF8EE. -->
<Rive version="1" kind="fragment">
    <Artboard width="200" height="200" name="cotuong" id="0:1">
        <!-- LƯU Ý thứ tự vẽ (Rive): con ĐẦU TIÊN trong danh sách vẽ Ở TRÊN cùng.
             Nên xếp từ trước ra sau: chi tiết -> mặt trong -> mặt ngoài -> bàn. -->
        <!-- Quân Tướng: node để trượt + nhún cả cụm -->
        <Node x="100" y="100" name="Piece" id="0:3">
            <Shape x="0" y="0" name="Dot" id="0:6">
                <Ellipse originX="0.5" originY="0.5" width="14" height="14" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFF5A60" name="Color"/>
                </Fill>
            </Shape>
            <Shape x="0" y="0" name="Inner" id="0:5">
                <Ellipse originX="0.5" originY="0.5" width="52" height="52" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFF8EE" name="Color"/>
                </Fill>
                <Stroke thickness="2" name="Stroke">
                    <SolidColor colorValue="FF241A38" name="Color"/>
                </Stroke>
            </Shape>
            <Shape x="0" y="0" name="Outer" id="0:4">
                <Ellipse originX="0.5" originY="0.5" width="68" height="68" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFF5A60" name="Color"/>
                </Fill>
                <Stroke thickness="4" name="Stroke">
                    <SolidColor colorValue="FF241A38" name="Color"/>
                </Stroke>
            </Shape>
        </Node>
        <!-- Đường kẻ bàn (sau cùng = nằm dưới) -->
        <Shape x="100" y="152" name="Board" id="0:2">
            <Rectangle originX="0.5" originY="0.5" width="160" height="6" cornerRadiusTL="3" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FF2EC5B6" name="Color"/>
            </Fill>
        </Shape>
        <LinearAnimation duration="180" fps="60" loopValue="loop" name="loop" id="0:7">
            <KeyedObject objectId="0:3">
                <KeyedProperty property="x">
                    <KeyFrameDouble frame="0" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="45" value="145" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="90" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="135" value="55" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="180" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                </KeyedProperty>
                <KeyedProperty property="y">
                    <KeyFrameDouble frame="0" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="45" value="94" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="90" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="135" value="94" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble frame="180" value="100" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
